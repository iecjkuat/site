{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./*"]
    },
    "checkJs": false,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "server.js",
    "config/**/*.js",
    "lib/**/*.js",
    "api/**/*.js",
    "pages/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
