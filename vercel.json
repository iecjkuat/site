{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server.js",
          "package.json",
          "lib/**",
          "config/**",
          "pages/**",
          "shared/**",
          "api/**",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/shared/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/events/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/projects/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/about/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "server.js": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
