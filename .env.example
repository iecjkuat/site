# PostgreSQL + Supabase Configuration
# Replace these values with your actual Supabase project credentials

# Database (from Supabase Settings → Database)
DATABASE_URL="postgresql://postgres:YOUR_SECURE_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase (from Supabase Settings → API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key_here"

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (CRITICAL: Generate a secure random string - minimum 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_SECURE_64_CHARACTER_RANDOM_STRING_GENERATED_ABOVE"

# CORS Configuration (Production domains - comma separated)
ALLOWED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_secure_app_password
EMAIL_FROM="Your Club Name <your_email@domain.com>"

# Payment Configuration (Lipana.dev M-Pesa)
LIPANA_PUBLISHABLE_KEY=your_lipana_publishable_key_here
LIPANA_LIVE_KEY=your_lipana_live_key_here
LIPANA_BASE_URL=https://api.lipana.dev
LIPANA_CALLBACK_URL=https://yourdomain.com/api/payment-service/lipana/callback

# Legacy M-Pesa Configuration (if needed)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback

# Frontend URL (for email links)
FRONTEND_URL=https://yourdomain.com

# JKUAT Portal Integration (optional)
JKUAT_PORTAL_URL=https://portal.jkuat.ac.ke/api
JKUAT_PORTAL_API_KEY=your_jkuat_api_key

# Web Push Notifications (VAPID keys) - Leave empty to disable
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Security Settings
SESSION_SECRET="REPLACE_WITH_ANOTHER_SECURE_64_CHARACTER_RANDOM_STRING"
ENCRYPTION_KEY="REPLACE_WITH_32_CHARACTER_ENCRYPTION_KEY"

# Rate Limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf,text/plain"

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true