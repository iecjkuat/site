# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key_here"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ── Payment (Lipana M-Pesa) ───────────────────────────────────────────────────
LIPANA_API_KEY=your_lipana_live_key_here
LIPANA_WEBHOOK_SECRET=your_lipana_webhook_secret_here
LIPANA_ENVIRONMENT=production
LIPANA_CALLBACK_URL=https://yourdomain.com/api/v1/membership/webhook
