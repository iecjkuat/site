# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key_here"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (your production domain)
# e.g. ALLOWED_ORIGINS=https://iecjkuat.vercel.app,https://iecjkuat.com
ALLOWED_ORIGINS=https://iecjkuat.vercel.app

# ── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here

# ── Admin ────────────────────────────────────────────────────────────────────
# Secret required to create new admin accounts at /iec-admin
# Share this only with committee members who need admin access
ADMIN_SIGNUP_SECRET=change-this-to-a-strong-secret

